# .ts dağıtıcısı: origin'in ilettiği yayını HTTP üzerinden kesintisiz MPEG-TS olarak verir.
# RTMP portu (1935) dışarıya açılmaz; yalnızca origin bağlanır.
listen              1935;
max_connections     1000;
daemon              off;
srs_log_tank        console;
# info düzeyi, sorgu adresini (HOOK_SECRET) ve gövdesini (imza) loga yazar.
srs_log_level_v2    warn;

# API yalnızca iç ağdan kullanılır (oturum eşitleme ve bağlantı kesme); portu dışarıya açılmaz.
http_api {
    enabled         on;
    listen          1985;
}

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

vhost __defaultVhost__ {
    http_remux {
        enabled     on;
        mount       [vhost]/[app]/[stream].ts;
    }
    http_hooks {
        enabled         on;
        on_play         __HOOK_BASE__/play;
        on_stop         __HOOK_BASE__/stop;
    }
}
