# Origin: OBS yayınını alır, HLS üretir ve yayını .ts dağıtıcısına iletir.
# SRS aynı sanal sunucuda HLS ile kesintisiz .ts çıkışına izin vermez
# (bkz. docs/srs-findings.md), bu yüzden .ts çıkışı srs-ts.conf.tmpl içindedir.
# HTTP portu (8080) dışarıya açılmaz: HLS parçaları SRS'te korumasızdır,
# izleyiciye yalnızca API'deki /hls geçidi üzerinden verilir.
listen              1935;
max_connections     1000;
daemon              off;
srs_log_tank        console;
# info düzeyi, sorgu adresini (HOOK_SECRET) ve gövdesini (gizli yayın anahtarı, imza) loga yazar.
srs_log_level_v2    warn;

http_api {
    enabled         on;
    listen          1985;
}

http_server {
    enabled         on;
    listen          8080;
    dir             ./objs/nginx/html;
}

vhost __defaultVhost__ {
    # Düşük gecikme: paketler bekletilmeden gönderilir. Anahtar kare önbelleği açık kalır; yeni
    # izleyici son anahtar kareden başlar (yayıncının anahtar kare aralığı kadar geriden).
    tcp_nodelay     on;
    min_latency     on;
    play {
        gop_cache       on;
        queue_length    10;
        mw_latency      100;
    }
    publish {
        mr          off;
    }
    hls {
        enabled         on;
        hls_fragment    2;
        hls_window      12;
        hls_ctx         off;
        hls_ts_ctx      off;
    }
    forward {
        enabled         on;
        destination     srs-ts:1935;
    }
    http_hooks {
        enabled         on;
        on_publish      __HOOK_BASE__/publish;
        on_unpublish    __HOOK_BASE__/unpublish;
        # Origin'e RTMP ile bağlanıp izlemek bir izleyici yolu değildir; API yalnızca kayıtlı bir
        # edge'in yayın çekmesini kabul eder.
        on_play         __HOOK_BASE__/play-origin;
    }
}
