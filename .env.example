TOKEN_KEY=dev-token-key-0123456789abcdef0123456789
HOOK_SECRET=dev-hook-secret-0123456789
# SRS'in API'ye sorduğu iç adres. 8001 portu dışarıya açılmaz.
HOOK_BASE=http://api:8001/hooks/srs/dev-hook-secret-0123456789
# Yayıncıların OBS'e yazacağı sunucu adresi (panelde gösterilir).
INGEST_BASE_URL=rtmp://localhost/live
# Panelin alan adı. Panel yalnızca caddy servisinden HTTPS ile sunulur. Gerçek bir alan adında
# (ör. panel.ornek.com) Caddy sertifikayı ACME ile alır; alan adı sunucuya yönlenmeli, 80 ve 443
# açık olmalıdır. localhost'ta Caddy'nin iç CA'sı kullanılır (tarayıcı ilk açılışta uyarır; bkz. README).
PANEL_DOMAIN=localhost
# Panel Caddy'nin arkasında: istemcinin adresi Caddy'nin yazdığı X-Forwarded-For'dan okunur ve
# giriş çerezi yalnızca HTTPS'ten gönderilir (PANEL_INSECURE_COOKIE yazılmaz, varsayılanı false).
PANEL_TRUST_PROXY_HEADERS=true
# Oynatıcıya "sunucu adresi" olarak girilen dış adres.
PUBLIC_BASE_URL=http://localhost:8000
EDGE_TS_BASE_URL=http://localhost:8081
EDGE_HLS_BASE_URL=http://localhost:8000
# Bir IP'nin 5 dakikada yapabileceği hatalı giriş sayısı. Varsayılan 20'dir; uçtan uca test
# bilerek hatalı giriş yaptığı için yerelde yüksek tutulur. Sunucuda bu satırı silin.
LOGIN_MAX_FAILURES=1000
